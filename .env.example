# SkillBridge Root Environment Variables Example
# ----------------------------------------------------
# This project is split into client and server components.
# Each component reads configuration from its respective .env file.
# 
# NEVER commit .env files containing real secrets to version control.
# Use this file as a template for variable names.

# ====================================================
# Client Environment Variables (client/.env)
# ====================================================
# Backend API Base URL (leave blank or '/api' for local dev with Vite proxy)
# In production, set to your Render backend URL, e.g. https://your-server.onrender.com/api
# VITE_API_BASE_URL=

# Supabase API (from Supabase Project Settings -> API)
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# ====================================================
# Server Environment Variables (server/.env)
# ====================================================
# Server Port and Node Environment
# PORT=5000
# NODE_ENV=development

# JWT Secret for authentication tokens
# JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters

# Supabase Credentials (from Supabase Project Settings -> API)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-publishable-or-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
