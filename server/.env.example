# SkillBridge Server Environment Variables Example

PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_characters

# Supabase Credentials (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
# Use your anon key or service_role key
SUPABASE_KEY=your-supabase-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
