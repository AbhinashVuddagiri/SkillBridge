# SkillBridge Frontend Environment Variables Example

# Backend API Base URL
# Leave blank or '/api' for local development (uses Vite proxy)
# In production, set to your deployed backend URL, e.g.: https://your-server.onrender.com/api
VITE_API_BASE_URL=

# Supabase Configuration (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
