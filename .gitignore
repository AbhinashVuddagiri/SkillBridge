# ====================================================
# Sensitive Files & Secrets
# ====================================================
# Environment variable files
.env
.env.*
.env.local
.env.development
.env.test
.env.production
.env.staging
*.env
*.env.*
*.local

# Allow example / template environment files only
!.env.example
!**/.env.example
!.env.*.example
!**/.env.*.example

# Private keys, certificates, and credentials
*.pem
*.key
*.cer
*.cert
*.pfx
*.p12
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.pub
*.asc

# Service credentials & API tokens
serviceAccountKey*.json
*service-account*.json
credentials.json
*credentials*.json
client_secret*.json
*.token

# Package manager auth files
.npmrc
.yarnrc

# ====================================================
# Dependencies
# ====================================================
node_modules/
*/node_modules/
.pnp
.pnp.js

# ====================================================
