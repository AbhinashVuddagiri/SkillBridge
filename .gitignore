# ====================================================
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/
*/out/
*.tsbuildinfo
.vite/
*/.vite/
.next/
.nuxt/
.turbo/

# ====================================================
# Logs & Runtime
# ====================================================
logs/
*/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pids/
*.pid
*.seed
*.pid.lock

# ====================================================
# Testing & Code Coverage
# ====================================================
coverage/
*/coverage/
*.lcov
.nyc_output/

# ====================================================
