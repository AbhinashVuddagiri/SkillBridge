# ====================================================
*.sqlite
*.sqlite3
*.dump
*.backup
*.sql.dump

# ====================================================
# Operating System Files
# ====================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

